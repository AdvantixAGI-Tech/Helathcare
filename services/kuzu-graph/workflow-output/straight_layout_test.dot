		penwidth=1.2,
		style=solid];
	TREATMENT_PLANNING -> RIGHT_SPACER	[style=invis,
		weight=100];
	RIGHT_SPACER -> COLOR_LEGEND	[minlen=1,
		style=invis,
		weight=100];
}
