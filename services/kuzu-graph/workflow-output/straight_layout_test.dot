digraph NiraivaCancerPatientWorkflow {
	graph [bgcolor=white,
		concentrate=false,
		fontname=Arial,
		fontsize=26,
		label="Niraiva Cancer Patient Workflow",
		labelloc=t,
		newrank=true,
		nodesep=0.35,
		outputorder=edgesfirst,
		pad=0.4,
		rankdir=TB,
		ranksep=0.65,
		splines=ortho
	];
	node [color="#5B7C99",
		fontname=Arial,
		fontsize=9,
		margin="0.12,0.08",
		penwidth=1.2,
		style="filled,rounded"
	];
	edge [arrowsize=0.7,
		color="#6B879D",
		fontcolor="#3F4F5F",
		fontname=Arial,
		fontsize=8,
		penwidth=1.1
	];
	subgraph cluster_color_legend {
		graph [bgcolor="#FAFCFD",
			color="#AFC2D1",
			fontname="Arial Bold",
			fontsize=12,
			label="Legend - Color and Line Meaning",
			labelloc=t,
			margin=10,
			style=rounded
		];
		COLOR_LEGEND	[label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="5" CELLPADDING="4">
          <TR><TD BGCOLOR="#DDEBF7" WIDTH="24"> </TD><TD ALIGN="LEFT">Clinical process</TD><TD BGCOLOR="#9DC3E6" WIDTH="24"> </TD><TD ALIGN="LEFT">Start / end / major state</TD></TR>
          <TR><TD BGCOLOR="#FFE699"> </TD><TD ALIGN="LEFT">Decision / lifestyle risk</TD><TD BGCOLOR="#E4DFEC"> </TD><TD ALIGN="LEFT">Laboratory / imaging</TD></TR>
          <TR><TD BGCOLOR="#F4CCCC"> </TD><TD ALIGN="LEFT">Biopsy / pathology</TD><TD BGCOLOR="#F8CBAD"> </TD><TD ALIGN="LEFT">Biomarkers / receptors</TD></TR>
          <TR><TD BGCOLOR="#E2F0D9"> </TD><TD ALIGN="LEFT">Monitoring / protective</TD><TD BGCOLOR="#C6E0B4"> </TD><TD ALIGN="LEFT">TNM staging</TD></TR>
          <TR><TD BGCOLOR="#FFD966"> </TD><TD ALIGN="LEFT">Cancer stage group</TD><TD BGCOLOR="#F4B183"> </TD><TD ALIGN="LEFT">Advanced / metastatic</TD></TR>
          <TR><TD BGCOLOR="#E7E6E6"> </TD><TD ALIGN="LEFT">Reported value / note</TD><TD ALIGN="LEFT"><B>Lines</B></TD><TD ALIGN="LEFT">Solid: workflow; Dashed: detail</TD></TR>
        </TABLE>
      >,
			shape=plain];
	}
	{
		graph [rank=same];
		TREATMENT_PLANNING	[fillcolor="#F8CBAD",
			label="Multidisciplinary Treatment\nPlanning\nStage, profile/grade, patient factors and\npreferences guide surgery, radiation,\nchemotherapy, \
immunotherapy,\ntargeted/hormone/systemic therapy and\nsupportive or palliative care",
			shape=box];
		COLOR_LEGEND;
		RIGHT_SPACER	[fixedsize=true,
			height=0.01,
			shape=box,
			style=invis,
			width=8];
	}
	INITIAL	[fillcolor="#9DC3E6",
		label="Initial\nCancer workflow begins",
		shape=circle,
		style=filled];
	PATIENT_PROFILE	[fillcolor="#DDEBF7",
		label="Patient Profile\nAge gender demographics and observation\nmetadata",
		shape=box];
	INITIAL -> PATIENT_PROFILE	[constraint=true,
		fontcolor="#33495B",
		minlen=1,
		penwidth=1.2,
		style=solid];
	LIFESTYLE	[fillcolor="#FFE699",
		label="Lifestyle and Exposure Assessment\nSmoking alcohol diet obesity physical\nactivity and UV exposure",
		shape=box];
	PATIENT_PROFILE -> LIFESTYLE	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid];
	LUNG_PROBABILITY_MODEL	[fillcolor="#DDEBF7",
		label="Lung Cancer Risk Inputs\nUse recorded gender smoking status and\nquit-smoking age when applicable",
		shape=box];
	PATIENT_PROFILE -> LUNG_PROBABILITY_MODEL	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid];
	D2_ACTIVITY	[fillcolor="#E2F0D9",
		label="Physical Activity\nActivity type; frequency; intensity;\nduration; minutes per week and sedentary\nbehaviour\nReported value: Up \
to ~50% lower colorectal risk; 48%\nlower among men in one cited study",
		shape=box];
	LIFESTYLE -> D2_ACTIVITY	[arrowsize=0.55,
		color="#9AA7B2",
		constraint=true,
		fontcolor="#33495B",
		penwidth=0.9,
		style=dashed];
	D2_ALCOHOL	[fillcolor="#FFE699",
		label="Alcohol Consumption\nAlcohol status; type; units per week;\nfrequency; duration\nReported value: ~4-5% cancer attribution; cited \
male\nfractions ~25-50% for several cancers",
		shape=box];
	LIFESTYLE -> D2_ALCOHOL	[arrowsize=0.55,
		color="#9AA7B2",
		constraint=true,
		fontcolor="#33495B",
		penwidth=0.9,
		style=dashed];
	D2_DIET	[fillcolor="#FFE699",
		label="Diet and Nutrition\nDietary pattern; fruit; vegetables; fibre;\nwhole grains; processed foods",
		shape=box];
	LIFESTYLE -> D2_DIET	[arrowsize=0.55,
		color="#9AA7B2",
		constraint=true,
		fontcolor="#33495B",
		penwidth=0.9,
		style=dashed];
	D2_OBESITY	[fillcolor="#FFE699",
		label="Obesity and Body Weight\nBMI; body weight; waist measurement;\noverweight or obesity status; weight\nhistory\nReported value: Esophageal: \
29% men, 37% women;\nendometrial: ~36%; gallbladder: 11% men,\n42% women",
		shape=box];
	LIFESTYLE -> D2_OBESITY	[arrowsize=0.55,
		color="#9AA7B2",
		constraint=true,
		fontcolor="#33495B",
		penwidth=0.9,
		style=dashed];
	D2_RED_MEAT	[fillcolor="#FFE699",
		label="Red and Processed Meat\nRed meat and processed meat consumption;\nservings and quantity per week\nReported value: Recommended maximum: \
18 oz / ~510 g / 3-4\nservings per week",
		shape=box];
	LIFESTYLE -> D2_RED_MEAT	[arrowsize=0.55,
		color="#9AA7B2",
		constraint=true,
		fontcolor="#33495B",
		penwidth=0.9,
		style=dashed];
	D2_SMOKING	[fillcolor="#FFE699",
		label="Smoking and Tobacco\nSmoking status; tobacco exposure;\nduration; frequency; cigarettes per day\nReported value: >80% cited lung-cancer \
attribution;\n~10-20x lung-cancer risk",
		shape=box];
	LIFESTYLE -> D2_SMOKING	[arrowsize=0.55,
		color="#9AA7B2",
		constraint=true,
		fontcolor="#33495B",
		penwidth=0.9,
		style=dashed];
	D2_UV	[fillcolor="#FFE699",
		label="Ultraviolet Exposure\nSun exposure; UV exposure; occupation;\ntanning exposure; duration and protection",
		shape=box];
	LIFESTYLE -> D2_UV	[arrowsize=0.55,
		color="#9AA7B2",
		constraint=true,
		fontcolor="#33495B",
		penwidth=0.9,
		style=dashed];
	COMBINED_LIFESTYLE_VALUE	[color="#8A98A6",
		fillcolor="#E7E6E6",
		label="Combined Lifestyle Impact\nAbout 18% of cancer cases and 16% of\ncancer deaths in one reviewed estimate",
		penwidth=1.0,
		shape=note,
		style="filled,dashed"];
	LIFESTYLE -> COMBINED_LIFESTYLE_VALUE	[arrowsize=0.55,
		color="#9AA7B2",
		constraint=true,
		fontcolor="#33495B",
		minlen=1,
		penwidth=0.9,
		style=dashed];
	ENVIRONMENTAL_EXPOSURES	[color="#8A98A6",
		fillcolor="#FFE699",
		label="Environmental Exposures\nAir and water quality; inorganic arsenic;\noccupational glyphosate, malathion and\ndiazinon",
		penwidth=1.0,
		shape=box,
		style="filled,dashed,rounded"];
	LIFESTYLE -> ENVIRONMENTAL_EXPOSURES	[arrowsize=0.55,
		color="#9AA7B2",
		constraint=true,
		fontcolor="#33495B",
		penwidth=0.9,
		style=dashed];
	FOOD_EVIDENCE_CAUTION	[color="#8A98A6",
		fillcolor="#FFE699",
		label="Food Evidence and Cautions\nHigh-temperature cooking; acrylamide\nuncertainty; glycemic load; very hot\ndrinks; coffee; GM, irradiated \
food,\nmicrowave, supplements and detox claims",
		penwidth=1.0,
		shape=box,
		style="filled,dashed,rounded"];
	LIFESTYLE -> FOOD_EVIDENCE_CAUTION	[arrowsize=0.55,
		color="#9AA7B2",
		constraint=true,
		fontcolor="#33495B",
		minlen=2,
		penwidth=0.9,
		style=dashed];
	LIFESTYLE_PATHWAYS	[color="#8A98A6",
		fillcolor="#FFE699",
		label="Lifestyle Biological Pathways\nDNA damage; acetaldehyde; oxidative\nstress; inflammation;\nhormonal/metabolic/immune and microbiome\npathways; \
tobacco-alcohol and\nalcohol-hepatitis interactions",
		penwidth=1.0,
		shape=box,
		style="filled,dashed,rounded"];
	LIFESTYLE -> LIFESTYLE_PATHWAYS	[arrowsize=0.55,
		color="#9AA7B2",
		constraint=true,
		fontcolor="#33495B",
		minlen=3,
		penwidth=0.9,
		style=dashed];
	LIFESTYLE_RISK_SUMMARY	[fillcolor="#FFE699",
		label="Lifestyle Risk Summary\nCombine assessed lifestyle and exposure\nfactors to inform risk-aware screening and\nclinical review",
		shape=box];
	LIFESTYLE -> LIFESTYLE_RISK_SUMMARY	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid];
	SYMPTOM_DECISION	[fillcolor="#FFE699",
		label="Concerning Symptoms or Clinical\nChanges?\nSelect screening or diagnostic path",
		shape=diamond,
		style=filled];
	SCREENING	[fillcolor="#DDEBF7",
		label="Cancer-Specific Screening\nScreening where applicable",
		shape=box];
	SYMPTOM_DECISION -> SCREENING	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid,
		xlabel="No - Routine screening"];
	DIAGNOSTIC_ENCOUNTER	[fillcolor="#DDEBF7",
		label="Diagnostic Clinical Encounter\nClinical encounter for symptoms or\nfindings",
		shape=box];
	SYMPTOM_DECISION -> DIAGNOSTIC_ENCOUNTER	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid,
		xlabel="Yes - Symptoms present"];
	SUSPICIOUS_DECISION	[fillcolor="#FFE699",
		label="Suspicious Clinical Finding?\nDetermine whether further investigation is\nrequired",
		shape=diamond,
		style=filled];
	SCREENING -> SUSPICIOUS_DECISION	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid];
	CLINICAL_ASSESSMENT	[fillcolor="#DDEBF7",
		label="Clinical Assessment\nAssessment of systemic surface and\nfunctional changes",
		shape=box];
	DIAGNOSTIC_ENCOUNTER -> CLINICAL_ASSESSMENT	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid];
	CLINICAL_ASSESSMENT -> SUSPICIOUS_DECISION	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid];
	D1_BREAST	[color="#8A98A6",
		fillcolor="#DDEBF7",
		label="Breast Clinical Signs\nLump or thickening; location; size; skin\nor shape change; nipple change; discharge;\npain; duration; progression",
		penwidth=1.0,
		shape=box,
		style="filled,dashed,rounded"];
	CLINICAL_ASSESSMENT -> D1_BREAST	[arrowsize=0.55,
		color="#9AA7B2",
		constraint=true,
		fontcolor="#33495B",
		minlen=1,
		penwidth=0.9,
		style=dashed];
	ROUTINE_MONITORING	[fillcolor="#E2F0D9",
		label="Routine Monitoring\nMonitoring when no suspicious finding is\nidentified",
		shape=box];
	SUSPICIOUS_DECISION -> ROUTINE_MONITORING	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid,
		xlabel="No - Routine monitoring"];
	DIAGNOSTIC_WORKUP	[fillcolor="#DDEBF7",
		label="Diagnostic Work-up\nLaboratory and imaging assessment",
		shape=box];
	SUSPICIOUS_DECISION -> DIAGNOSTIC_WORKUP	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid,
		xlabel="Yes - Investigate"];
	FOLLOWUP	[fillcolor="#DDEBF7",
		label="Follow-up and Surveillance\nSymptoms laboratory tests imaging\nlifestyle and well-being",
		shape=box];
	ROUTINE_MONITORING -> FOLLOWUP	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid];
	LAB_ASSESSMENT	[fillcolor="#E4DFEC",
		label="Laboratory Assessment\nCBC CMP CRP and ESR measurements",
		shape=box];
	DIAGNOSTIC_WORKUP -> LAB_ASSESSMENT	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid,
		xlabel="Laboratory tests"];
	IMAGING_ASSESSMENT	[fillcolor="#E4DFEC",
		label="Imaging Assessment\nCancer-specific imaging where applicable",
		shape=box];
	DIAGNOSTIC_WORKUP -> IMAGING_ASSESSMENT	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid,
		xlabel=Imaging];
	ABNORMALITY_DECISION	[fillcolor="#FFE699",
		label="Suspicious Lesion or Abnormality?\nReview clinical imaging and laboratory\nfindings",
		shape=diamond,
		style=filled];
	LAB_ASSESSMENT -> ABNORMALITY_DECISION	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid];
	D1_CBC	[fillcolor="#E4DFEC",
		label="CBC Assessment\nHemoglobin; RBC; WBC; platelets;\nRBC-related indices; WBC differential",
		shape=box];
	LAB_ASSESSMENT -> D1_CBC	[arrowsize=0.55,
		color="#9AA7B2",
		constraint=true,
		fontcolor="#33495B",
		minlen=1,
		penwidth=0.9,
		style=dashed];
	D1_CMP	[fillcolor="#E4DFEC",
		label="CMP Assessment\nALP; AST; ALT; calcium; albumin;\nbilirubin; other metabolic measurements",
		shape=box];
	LAB_ASSESSMENT -> D1_CMP	[arrowsize=0.55,
		color="#9AA7B2",
		constraint=true,
		fontcolor="#33495B",
		minlen=2,
		penwidth=0.9,
		style=dashed];
	D1_INFLAMMATION	[fillcolor="#E4DFEC",
		label="Inflammation Assessment\nCRP and ESR; previous value; current\nvalue; date and trend",
		shape=box];
	LAB_ASSESSMENT -> D1_INFLAMMATION	[arrowsize=0.55,
		color="#9AA7B2",
		constraint=true,
		fontcolor="#33495B",
		minlen=3,
		penwidth=0.9,
		style=dashed];
	IMAGING_ASSESSMENT -> ABNORMALITY_DECISION	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid];
	D1_IMAGING_METHOD	[fillcolor="#E4DFEC",
		label="Imaging Method\nMammography; CT; MRI; ultrasound or other\napplicable imaging",
		shape=box];
	IMAGING_ASSESSMENT -> D1_IMAGING_METHOD	[arrowsize=0.55,
		color="#9AA7B2",
		constraint=true,
		fontcolor="#33495B",
		minlen=1,
		penwidth=0.9,
		style=dashed];
	D1_LESION	[fillcolor="#E4DFEC",
		label="Lesion Characteristics\nPresence; location; size; shape; margins;\ncount",
		shape=box];
	IMAGING_ASSESSMENT -> D1_LESION	[arrowsize=0.55,
		color="#9AA7B2",
		constraint=true,
		fontcolor="#33495B",
		minlen=2,
		penwidth=0.9,
		style=dashed];
	D1_SPREAD	[fillcolor="#E4DFEC",
		label="Spread Assessment\nRegional lymph-node findings and distant\nfindings",
		shape=box];
	IMAGING_ASSESSMENT -> D1_SPREAD	[arrowsize=0.55,
		color="#9AA7B2",
		constraint=true,
		fontcolor="#33495B",
		minlen=3,
		penwidth=0.9,
		style=dashed];
	MONITOR_REASSESS	[fillcolor="#E2F0D9",
		label="Monitor and Reassess\nRepeat assessment when appropriate",
		shape=box];
	ABNORMALITY_DECISION -> MONITOR_REASSESS	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid,
		xlabel="No - Reassess"];
	BIOPSY	[fillcolor="#F4CCCC",
		label="Biopsy or Tissue Sampling\nTissue sampling where clinically\napplicable",
		shape=box];
	ABNORMALITY_DECISION -> BIOPSY	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid,
		xlabel="Yes - Biopsy"];
	MONITOR_REASSESS -> FOLLOWUP	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid,
		xlabel="Return to surveillance"];
	PATHOLOGY	[fillcolor="#F4CCCC",
		label="Pathology Assessment\nHistology tumor classification and\npathology observations",
		shape=box];
	BIOPSY -> PATHOLOGY	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid];
	D1_BIOPSY	[fillcolor="#F4CCCC",
		label="Biopsy Details\nBiopsy method; date; anatomical site;\nspecimen",
		shape=box];
	BIOPSY -> D1_BIOPSY	[arrowsize=0.55,
		color="#9AA7B2",
		constraint=true,
		fontcolor="#33495B",
		minlen=1,
		penwidth=0.9,
		style=dashed];
	D1_HISTOLOGY	[fillcolor="#F4CCCC",
		label="Histopathology\nHistology; tumour classification;\nmicroscopic observations",
		shape=box];
	PATHOLOGY -> D1_HISTOLOGY	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid];
	D3_PATH_STAGE	[fillcolor="#C6E0B4",
		label="Pathological TNM pTNM\nPathological stage established using\npreoperative evidence plus surgical and\nhistopathological findings",
		shape=box];
	PATHOLOGY -> D3_PATH_STAGE	[arrowsize=0.55,
		color="#9AA7B2",
		constraint=true,
		fontcolor="#33495B",
		penwidth=0.9,
		style=dashed];
	MALIGNANCY_DECISION	[fillcolor="#FFE699",
		label="Malignancy Confirmed?\nPathology confirmation decision",
		shape=diamond,
		style=filled];
	NON_MALIGNANT_FOLLOWUP	[fillcolor="#E2F0D9",
		label="Non-Malignant Follow-up\nNon-cancer follow-up or general care when\nmalignancy is not confirmed",
		shape=box];
	MALIGNANCY_DECISION -> NON_MALIGNANT_FOLLOWUP	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid,
		xlabel="No - Non-malignant"];
	CANCER_CLASSIFICATION	[fillcolor="#F4B183",
		label="Cancer Type Classification\nCancer-specific classification",
		shape=box];
	MALIGNANCY_DECISION -> CANCER_CLASSIFICATION	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid,
		xlabel="Yes - Malignant"];
	TERMINAL	[fillcolor="#9DC3E6",
		label="Module End\nEnd of current workflow cycle",
		shape=doublecircle,
		style=filled];
	NON_MALIGNANT_FOLLOWUP -> TERMINAL	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid,
		xlabel="General care / close pathway"];
	BREAST_DECISION	[fillcolor="#FFE699",
		label="Breast Cancer Pathway?\nDetermine whether breast-specific receptor\ndata apply",
		shape=diamond,
		style=filled];
	CANCER_CLASSIFICATION -> BREAST_DECISION	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid];
	RECEPTOR_ASSESSMENT	[fillcolor="#F8CBAD",
		label="HER2 ER and PR Assessment\nBreast-specific receptor assessment where\napplicable",
		shape=box];
	BREAST_DECISION -> RECEPTOR_ASSESSMENT	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid,
		xlabel="Yes - Breast pathway"];
	TNM_ASSESSMENT	[fillcolor="#A9D18E",
		label="TNM Assessment\nAssessment of primary tumor regional nodes\nand distant metastasis",
		shape=box];
	BREAST_DECISION -> TNM_ASSESSMENT	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid,
		xlabel="No - Other cancer"];
	RECEPTOR_ASSESSMENT -> TNM_ASSESSMENT	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid];
	D1_ER	[fillcolor="#F8CBAD",
		label="Estrogen Receptor\nER staining result; positive percentage;\nfinal ER status",
		shape=box];
	RECEPTOR_ASSESSMENT -> D1_ER	[arrowsize=0.55,
		color="#9AA7B2",
		constraint=true,
		fontcolor="#33495B",
		penwidth=0.9,
		style=dashed];
	D1_HER2	[fillcolor="#F8CBAD",
		label="HER2 Assessment\nIHC result; FISH result; ERBB2 signal;\nratio; final HER2 status",
		shape=box];
	RECEPTOR_ASSESSMENT -> D1_HER2	[arrowsize=0.55,
		color="#9AA7B2",
		constraint=true,
		fontcolor="#33495B",
		penwidth=0.9,
		style=dashed];
	D1_PR	[fillcolor="#F8CBAD",
		label="Progesterone Receptor\nPR staining result; positive percentage;\nfinal PR status",
		shape=box];
	RECEPTOR_ASSESSMENT -> D1_PR	[arrowsize=0.55,
		color="#9AA7B2",
		constraint=true,
		fontcolor="#33495B",
		penwidth=0.9,
		style=dashed];
	T_ASSESSMENT	[fillcolor="#C6E0B4",
		label="T - Primary Tumor Assessment\nTumor size depth and local extension",
		shape=box];
	TNM_ASSESSMENT -> T_ASSESSMENT	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid,
		xlabel=T];
	N_ASSESSMENT	[fillcolor="#C6E0B4",
		label="N - Regional Lymph Node Assessment\nRegional lymph-node involvement",
		shape=box];
	TNM_ASSESSMENT -> N_ASSESSMENT	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid,
		xlabel=N];
	M_ASSESSMENT	[fillcolor="#C6E0B4",
		label="M - Distant Metastasis Assessment\nPresence or absence of distant spread",
		shape=box];
	TNM_ASSESSMENT -> M_ASSESSMENT	[constraint=true,
		fontcolor="#33495B",
		penwidth=1.2,
		style=solid,
		xlabel=M];
	D3_CLINICAL_STAGE	[fillcolor="#C6E0B4",
		label="Clinical TNM cTNM\nClinical stage established before\ndefinitive treatment using clinical\nexamination and diagnostic investigations",
		shape=box];
	TNM_ASSESSMENT -> D3_CLINICAL_STAGE	[arrowsize=0.55,
		color="#9AA7B2",
		constraint=true,
		fontcolor="#33495B",
		minlen=1,
		penwidth=0.9,
		style=dashed];
	D3_OVERVIEW	[color="#8A98A6",
		fillcolor="#C6E0B4",
		label="Cancer Staging Overview\nCancer staging describes the anatomical\nextent of disease using clinical and\npathological information",
		penwidth=1.0,
		shape=box,
		style="filled,dashed,rounded"];
	TNM_ASSESSMENT -> D3_OVERVIEW	[arrowsize=0.55,
		color="#9AA7B2",
		constraint=true,
		fontcolor="#33495B",
