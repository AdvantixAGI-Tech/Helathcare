  subgraph cluster_color_legend {
    label="Color Description";
    labelloc="t";
    fontsize=14;
    fontname="Arial Bold";
    color="#B7C9D6";
    style="rounded";
    margin=14;
    rank=sink;
    "COLOR_LEGEND" [
      shape=plain,
      label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7">
          <TR><TD BGCOLOR="#DDEBF7"><B>Blue</B></TD><TD ALIGN="LEFT">Patient and clinical workflow</TD></TR>
          <TR><TD BGCOLOR="#9DC3E6"><B>Dark Blue</B></TD><TD ALIGN="LEFT">Initial, terminal and major states</TD></TR>
          <TR><TD BGCOLOR="#FFE699"><B>Yellow</B></TD><TD ALIGN="LEFT">Decision and lifestyle-risk assessment</TD></TR>
          <TR><TD BGCOLOR="#E4DFEC"><B>Purple</B></TD><TD ALIGN="LEFT">Laboratory and imaging assessment</TD></TR>
          <TR><TD BGCOLOR="#F4CCCC"><B>Pink</B></TD><TD ALIGN="LEFT">Biopsy and pathology</TD></TR>
          <TR><TD BGCOLOR="#F8CBAD"><B>Peach</B></TD><TD ALIGN="LEFT">Cancer biomarkers and receptors</TD></TR>
          <TR><TD BGCOLOR="#E2F0D9"><B>Light Green</B></TD><TD ALIGN="LEFT">Monitoring, follow-up and protective factors</TD></TR>
          <TR><TD BGCOLOR="#C6E0B4"><B>Green</B></TD><TD ALIGN="LEFT">TNM components and staging information</TD></TR>
          <TR><TD BGCOLOR="#FFD966"><B>Gold</B></TD><TD ALIGN="LEFT">Cancer stage groups</TD></TR>
          <TR><TD BGCOLOR="#F4B183"><B>Orange</B></TD><TD ALIGN="LEFT">Advanced cancer and distant metastasis</TD></TR>
          <TR><TD BGCOLOR="#E7E6E6"><B>Grey</B></TD><TD ALIGN="LEFT">Reported values, metadata and caution notes</TD></TR>
          <TR><TD><B>Solid arrow</B></TD><TD ALIGN="LEFT">Main patient workflow or decision branch</TD></TR>
          <TR><TD><B>Dashed arrow</B></TD><TD ALIGN="LEFT">Supporting PDF detail or evidence</TD></TR>
        </TABLE>
      >
    ];
  }
  "TERMINAL" -> "COLOR_LEGEND" [style=invis];
}
