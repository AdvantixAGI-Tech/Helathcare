  "FOOD_EVIDENCE_CAUTION" -> "LIFESTYLE_RISK_SUMMARY" [xlabel="", style=dashed, color="#8798A6", fontcolor="#33495B", fontsize=7, penwidth=1.0, arrowsize=0.70, headclip=true, tailclip=true, constraint=false];
  "LIFESTYLE_PATHWAYS" -> "LIFESTYLE_RISK_SUMMARY" [xlabel="", style=dashed, color="#8798A6", fontcolor="#33495B", fontsize=7, penwidth=1.0, arrowsize=0.70, headclip=true, tailclip=true, constraint=false];
  "TNM_ASSESSMENT" -> "POST_TREATMENT_RESTAGING" [xlabel="", style=dashed, color="#8798A6", fontcolor="#33495B", fontsize=7, penwidth=1.0, arrowsize=0.70, headclip=true, tailclip=true, constraint=true];
  "TNM_ASSESSMENT" -> "STAGE_EXTENT_SYSTEMS" [xlabel="", style=dashed, color="#8798A6", fontcolor="#33495B", fontsize=7, penwidth=1.0, arrowsize=0.70, headclip=true, tailclip=true, constraint=true];
  "TNM_ASSESSMENT" -> "STAGING_INVESTIGATIONS" [xlabel="", style=dashed, color="#8798A6", fontcolor="#33495B", fontsize=7, penwidth=1.0, arrowsize=0.70, headclip=true, tailclip=true, constraint=true];
  "TNM_ASSESSMENT" -> "STAGING_CAUTION" [xlabel="", style=dashed, color="#8798A6", fontcolor="#33495B", fontsize=7, penwidth=1.0, arrowsize=0.70, headclip=true, tailclip=true, constraint=true];
  "TREATMENT_PLANNING" -> "SURGICAL_PATHOLOGY_DECISION" [xlabel="After initial treatment\ndecision", style=solid, color="#4F6F86", fontcolor="#33495B", fontsize=7, penwidth=1.5, arrowsize=0.95, headclip=true, tailclip=true, constraint=true];
  "SURGICAL_PATHOLOGY_DECISION" -> "FOLLOWUP" [xlabel="No - pTNM unavailable /\nnot applicable", style=solid, color="#4F6F86", fontcolor="#33495B", fontsize=7, penwidth=1.5, arrowsize=0.95, headclip=true, tailclip=true, constraint=true];
  "SURGICAL_PATHOLOGY_DECISION" -> "SURGICAL_PATHOLOGY" [xlabel="Yes - surgical specimen\navailable", style=solid, color="#4F6F86", fontcolor="#33495B", fontsize=7, penwidth=1.5, arrowsize=0.95, headclip=true, tailclip=true, constraint=true];
  "SURGICAL_PATHOLOGY" -> "D3_PATH_STAGE" [xlabel="Derive pTNM where\napplicable", style=solid, color="#4F6F86", fontcolor="#33495B", fontsize=7, penwidth=1.5, arrowsize=0.95, headclip=true, tailclip=true, constraint=true];
  "D3_PATH_STAGE" -> "FOLLOWUP" [xlabel="Record postoperative\npathological stage", style=solid, color="#4F6F86", fontcolor="#33495B", fontsize=7, penwidth=1.5, arrowsize=0.95, headclip=true, tailclip=true, constraint=true];
  subgraph cluster_color_legend {
    label="Legend - Color and Line Meaning";
    labelloc="t"; fontsize=12; fontname="Arial Bold";
    color="#AFC2D1"; bgcolor="#FAFCFD"; style="rounded"; margin=10;
    "COLOR_LEGEND" [
      shape=plain,
      label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="5" CELLPADDING="4">
          <TR><TD BGCOLOR="#DDEBF7" WIDTH="24"> </TD><TD ALIGN="LEFT">Clinical process</TD><TD BGCOLOR="#9DC3E6" WIDTH="24"> </TD><TD ALIGN="LEFT">Start / end / major state</TD></TR>
          <TR><TD BGCOLOR="#FFE699"> </TD><TD ALIGN="LEFT">Decision / lifestyle risk</TD><TD BGCOLOR="#E4DFEC"> </TD><TD ALIGN="LEFT">Laboratory / imaging</TD></TR>
          <TR><TD BGCOLOR="#F4CCCC"> </TD><TD ALIGN="LEFT">Biopsy / pathology</TD><TD BGCOLOR="#F8CBAD"> </TD><TD ALIGN="LEFT">Biomarkers / receptors</TD></TR>
          <TR><TD BGCOLOR="#E2F0D9"> </TD><TD ALIGN="LEFT">Monitoring / protective</TD><TD BGCOLOR="#C6E0B4"> </TD><TD ALIGN="LEFT">TNM staging</TD></TR>
          <TR><TD BGCOLOR="#FFD966"> </TD><TD ALIGN="LEFT">Cancer stage group</TD><TD BGCOLOR="#F4B183"> </TD><TD ALIGN="LEFT">Advanced / metastatic</TD></TR>
          <TR><TD BGCOLOR="#E7E6E6"> </TD><TD ALIGN="LEFT">Reported value / note</TD><TD ALIGN="LEFT"><B>Lines</B></TD><TD ALIGN="LEFT">Solid: workflow; Dashed: detail</TD></TR>
        </TABLE>
      >
    ];
  }
  "RIGHT_SPACER" [shape=box, label="", width=8, height=0.01, fixedsize=true, style=invis];
  { rank=same; "TREATMENT_PLANNING"; "RIGHT_SPACER"; "COLOR_LEGEND"; }
  "TREATMENT_PLANNING" -> "RIGHT_SPACER" [style=invis, weight=100];
  "RIGHT_SPACER" -> "COLOR_LEGEND" [style=invis, weight=100];
}
